# Port HTTP de l'API (Render fournit PORT automatiquement)
PORT=3000

# Origine autorisée CORS (URL du front). '*' pour tout autoriser en dev.
CORS_ORIGIN=http://localhost:5173

# TTL du cache en mémoire (millisecondes)
CACHE_TTL_MS=30000

# Nombre max d'entrées dans le cache (éviction LRU au-delà)
CACHE_MAX_ENTRIES=100
