{
  "name": "edpulse-web",
  "version": "1.0.0",
  "description": "Edpulse test - Products frontend (React + Vite + TS)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
